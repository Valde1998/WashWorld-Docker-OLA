# Copy this file to .env and replace the three values below. Never commit .env.
DB_ROOT_PASSWORD=replace-with-a-random-root-password
DB_PASSWORD=replace-with-a-random-app-password
JWT_SECRET_KEY=replace-with-a-random-jwt-key-at-least-32-characters
NEXT_PUBLIC_API_URL=http://localhost:5001

# Optional real email delivery. Leave credentials empty for the local Docker demo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
# Optional Brevo delivery with a verified sender.
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
EMAIL_FROM=
EMAIL_FROM_NAME=WashWorld
FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_TTL_MINUTES=15
EMAIL_VERIFICATION_RESEND_SECONDS=60
